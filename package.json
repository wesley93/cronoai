{
  "name": "cronoai",
  "private": true,
  "version": "1.0.0",
  "description": "CronoAI - Copiloto de Planejamento de Obras & MS Project",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.2"
  },
  "engines": {
    "node": ">=22"
  }
