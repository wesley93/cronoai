<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3: o projeto de testes é um executável. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>CronoAI.Api.Testes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CronoAI.Api\CronoAI.Api.csproj" />
    <ProjectReference Include="..\..\src\CronoAI.Dados\CronoAI.Dados.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesma fonte do bootstrap usado pelo docker-compose: a fixture o executa no contêiner descartável. -->
    <None Include="..\..\db\bootstrap\01-papeis-e-schema.sh" Link="bootstrap\01-papeis-e-schema.sh" CopyToOutputDirectory="PreserveNewest" />
    <!-- Golden dos predicados de pg_policies: COPIADO da saída real do PostgreSQL (nunca escrito à mão). -->
    <None Include="Dados\predicados-esperados.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
