root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml,yaml,config}]
indent_size = 2

[*.sh]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Código gerado pelo EF Core (Migrations/): fora da análise de estilo e de regras do analisador.
# Motivo: o gerador não segue as convenções do projeto e é regerado pela ferramenta.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Testes: nomes de método com sublinhado descrevem o comportamento em português (convenção do plano 00011, seção 11).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
